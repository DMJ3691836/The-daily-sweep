//@version=5
indicator("The Daily Sweep", shorttitle="Daily Sweep", overlay=true, max_bars_back=500)

// ============================================================================
// INPUTS
// ============================================================================

// Input Groups (using constants, not var)
G_BIAS = "🔷 Daily Bias"
G_NY = "📍 New York Session"
G_FVG = "📦 Fair Value Gap"
G_FILTER = "🔧 Filters & Quality"
G_RRR = "📈 Risk-Reward"
G_DASH = "📊 Dashboard"
G_ALERTS = "🔔 Alerts"
G_VIS = "🎨 Visual"

// Daily Bias Settings
lookback = input.int(10, "Sweep Lookback (bars)", minval=3, maxval=50, group=G_BIAS,
                     tooltip="Number of 1H bars used to define the short-term swing high/low that price must sweep through.")
show_bias = input.bool(true, "Show Daily Bias Label", group=G_BIAS)
show_pdl = input.bool(true, "Show PDH / PDL Target Lines", group=G_BIAS)
show_pdhl_white = input.bool(true, "Show PDH / PDL in White (Cross-Reference Filter)", group=G_BIAS,
                             tooltip="Display Previous Day High/Low as white price points for easy cross-reference. Toggle on/off to filter.")

// New York Session Settings
ny_session = input.session("0930-1200", "NY Sweep Window", group=G_NY,
                          tooltip="Time window in New York time during which sweeps are monitored. Default covers the key NY open hours.")
show_sweep = input.bool(true, "Mark Sweeps on Chart", group=G_NY)

// Fair Value Gap Settings
show_fvg = input.bool(true, "Draw FVG Entry Boxes", group=G_FVG)
fvg_extend = input.int(50, "FVG Box Width (bars)", minval=5, maxval=500, group=G_FVG,
                       tooltip="How many bars to the right the FVG box extends while the setup is active.")
fvg_window = input.int(5, "FVG Lookback After Sweep", minval=1, maxval=20, group=G_FVG,
                       tooltip="Maximum number of bars after a sweep in which an aligned FVG must appear to be considered valid.")

// Filters & Quality Settings
use_atr_filter = input.bool(true, "Enable ATR Volatility Filter", group=G_FILTER,
                           tooltip="Only allow sweeps when volatility (ATR) is adequate. Filters noise in quiet conditions.")
min_atr_pct = input.float(0.3, "Min ATR % of Price", minval=0.0, maxval=2.0, step=0.1, group=G_FILTER,
                         tooltip="Minimum ATR as % of current price. Set 0 to disable. Higher = more selective.")

// Risk-Reward Settings
use_rr_filter = input.bool(true, "Enable RR Filter", group=G_RRR,
                          tooltip="Only show setups with risk-reward ratio above minimum threshold.")
min_rr_ratio = input.float(2.0, "Minimum RR Ratio", minval=1.0, maxval=5.0, step=0.5, group=G_RRR,
                          tooltip="Only show setups where reward/risk ≥ this ratio. 2.0 = 2:1 payoff.")
show_rr_label = input.bool(true, "Show RR on Chart", group=G_RRR)

// Dashboard Settings
show_dashboard = input.bool(true, "Enable Dashboard", group=G_DASH,
                           tooltip="Show real-time setup status and key metrics.")
dash_pos = input.string("top-left", "Dashboard Position", options=["top-left", "top-right", "bottom-left", "bottom-right"], group=G_DASH)

// Alerts Settings
use_json_alerts = input.bool(false, "Use JSON-style Alert Messages", group=G_ALERTS,
                            tooltip="Format alerts with JSON-like structure for journaling/automation.")

// Visual Settings
bull_col = input.color(color.new(#26A69A, 0), "Bullish Color", group=G_VIS)
bear_col = input.color(color.new(#EF5350, 0), "Bearish Color", group=G_VIS)

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

f_get_daily_bias() =>
    d_h1 = request.security(syminfo.tickerid, "D", high[1])
    d_h2 = request.security(syminfo.tickerid, "D", high[2])
    d_h3 = request.security(syminfo.tickerid, "D", high[3])
    d_l1 = request.security(syminfo.tickerid, "D", low[1])
    d_l2 = request.security(syminfo.tickerid, "D", low[2])
    d_l3 = request.security(syminfo.tickerid, "D", low[3])
    
    hh = d_h1 > d_h2 and d_h2 > d_h3
    ll = d_l1 < d_l2 and d_l2 < d_l3
    
    if hh and ll
        1
    else if not hh and not ll
        -1
    else
        0

f_get_daily_target(bias) =>
    if bias == 1
        request.security(syminfo.tickerid, "D", high[1])
    else if bias == -1
        request.security(syminfo.tickerid, "D", low[1])
    else
        na

f_in_ny_session() =>
    time_in_range(time, ny_session, "America/New_York")

f_get_sw_high() =>
    ta.highest(high, lookback)

f_get_sw_low() =>
    ta.lowest(low, lookback)

f_is_sweep(bias) =>
    if bias == 1
        low < f_get_sw_low() and close > f_get_sw_low()
    else if bias == -1
        high > f_get_sw_high() and close < f_get_sw_high()
    else
        false

f_check_fvg(bias) =>
    if bias == 1
        high[2] < low[0]
    else if bias == -1
        low[2] > high[0]
    else
        false

f_is_in_fvg_box(bias, fvg_high, fvg_low) =>
    if bias == 1
        low <= fvg_high and high >= fvg_low
    else if bias == -1
        low <= fvg_high and high >= fvg_low
    else
        false

f_get_atr_filter() =>
    atr = ta.atr(14)
    atr_pct = (atr / close) * 100
    use_atr_filter ? atr_pct >= min_atr_pct : true

// ============================================================================
// STATE VARIABLES
// ============================================================================

var int bias = 0
var float target = na
var bool sweep_confirmed = false
var int sweep_bar = 0
var float sweep_extreme = na
var bool fvg_confirmed = false
var float fvg_high = na
var float fvg_low = na
var int fvg_bar = 0
var bool entry_fired = false
var bool setup_active = false

// ============================================================================
// MAIN LOGIC
// ============================================================================

// Update daily bias
bias := f_get_daily_bias()
target := f_get_daily_target(bias)

// Reset on new day
if ta.change(time("D")) != 0
    sweep_confirmed := false
    fvg_confirmed := false
    entry_fired := false
    setup_active := false
    sweep_extreme := na
    fvg_high := na
    fvg_low := na

// Check for sweep during NY session
in_ny = f_in_ny_session()
if in_ny and bias != 0 and not sweep_confirmed
    if f_is_sweep(bias)
        sweep_confirmed := true
        sweep_bar := bar_index
        sweep_extreme := bias == 1 ? f_get_sw_low() : f_get_sw_high()

// Check for FVG after sweep
if sweep_confirmed and not fvg_confirmed
    bars_since_sweep = bar_index - sweep_bar
    if bars_since_sweep <= fvg_window
        if f_check_fvg(bias)
            fvg_confirmed := true
            fvg_bar := bar_index
            fvg_high := bias == 1 ? high[2] : high[0]
            fvg_low := bias == 1 ? low[0] : low[2]
            setup_active := true

// Check for pullback entry into FVG
if setup_active and fvg_confirmed and not entry_fired
    if f_is_in_fvg_box(bias, fvg_high, fvg_low)
        entry_fired := true

// Invalidate setup on stop or target
if setup_active
    if bias == 1 and (close < (sweep_extreme - syminfo.mintick))
        setup_active := false
    if bias == -1 and (close > (sweep_extreme + syminfo.mintick))
        setup_active := false
    if close == target
        setup_active := false

// ============================================================================
// ALERTS
// ============================================================================

if sweep_confirmed and not entry_fired
    msg = use_json_alerts ? 
          '{"event":"SWEEP","bias":"' + (bias == 1 ? "BULL" : "BEAR") + '"}' :
          "[Daily Sweep] " + (bias == 1 ? "Bullish" : "Bearish") + " sweep detected during NY session."
    if sweep_confirmed[1] == false
        alert(msg)

if fvg_confirmed and not entry_fired
    msg = use_json_alerts ?
          '{"event":"FVG","bias":"' + (bias == 1 ? "BULL" : "BEAR") + '"}' :
          "[Daily Sweep] " + (bias == 1 ? "Bullish" : "Bearish") + " FVG aligned."
    if fvg_confirmed[1] == false
        alert(msg)

if entry_fired
    msg = use_json_alerts ?
          '{"event":"ENTRY","bias":"' + (bias == 1 ? "BULL" : "BEAR") + '","entry":' + str.tostring(close) + '}' :
          "[Daily Sweep] " + (bias == 1 ? "Bullish" : "Bearish") + " pullback entry – price in FVG."
    if entry_fired[1] == false
        alert(msg)

// ============================================================================
// VISUALIZATION
// ============================================================================

// PDH / PDL lines
if show_pdl and not na(target)
    line.new(bar_index - lookback, target, bar_index, target,
             color=bias == 1 ? color.new(bull_col, 30) : bias == -1 ? color.new(bear_col, 30) : na,
             width=2, style=line.style_dashed, xloc=xloc.bar_index)

// Sweep label
if sweep_confirmed and show_sweep
    label.new(bar_index - (bar_index - sweep_bar), 
              bias == 1 ? high + (high * 0.005) : low - (low * 0.005),
              "SWEEP " + (bias == 1 ? "↑" : "↓"),
              color=bias == 1 ? bull_col : bear_col,
              textcolor=color.white,
              style=bias == 1 ? label.style_label_down : label.style_label_up,
              size=size.small)

// FVG box
if setup_active and show_fvg
    box.new(fvg_bar, fvg_high, bar_index + fvg_extend, fvg_low,
            bgcolor=color.new(bias == 1 ? bull_col : bear_col, 85),
            border_color=bias == 1 ? bull_col : bear_col,
            xloc=xloc.bar_index)

// Entry label
if entry_fired
    label.new(bar_index, 
              bias == 1 ? high + (high * 0.005) : low - (low * 0.005),
              "ENTRY →",
              color=color.new(color.yellow, 0),
              textcolor=color.black,
              style=label.style_label_center,
              size=size.small)

// Bias label (top-right)
if show_bias and bias != 0
    label.new(bar_index, high,
              (bias == 1 ? "🐂 BULLISH" : "🐻 BEARISH") + " | Target: " + str.tostring(target, "#.00"),
              color=bias == 1 ? bull_col : bear_col,
              textcolor=color.white,
              yloc=yloc.abovebar,
              xloc=xloc.bar_index,
              style=label.style_label_left,
              size=size.small)

// Risk-Reward on chart
if show_rr_label and setup_active and entry_fired
    entry_price = (fvg_high + fvg_low) / 2
    stop_price = sweep_extreme
    reward = math.abs(target - entry_price)
    risk = math.abs(entry_price - stop_price)
    rr = risk > 0 ? reward / risk : 0
    label.new(bar_index, entry_price, "RR: " + str.tostring(rr, "#.0"),
              color=color.new(color.gray, 50),
              textcolor=color.white,
              style=label.style_label_center,
              size=size.tiny)

// Dashboard
if show_dashboard
    pos = dash_pos == "top-left" ? position.top_left :
          dash_pos == "top-right" ? position.top_right :
          dash_pos == "bottom-left" ? position.bottom_left :
          position.bottom_right
    
    var table tb = table.new(pos, 2, 8, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)
    
    if barstate.islast
        table.cell(tb, 0, 0, "━━ DAILY SWEEP ━━", bgcolor=color.new(bias == 1 ? bull_col : bear_col, 0), text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 1, "Bias:", text_color=color.white, text_size=size.small)
        table.cell(tb, 1, 1, bias == 1 ? "🐂 BULL" : bias == -1 ? "🐻 BEAR" : "◆ NEUTRAL", text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 2, "Session:", text_color=color.white, text_size=size.small)
        table.cell(tb, 1, 2, in_ny ? "🟢 NY OPEN" : "◯ WAITING", text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 3, "Sweep:", text_color=color.white, text_size=size.small)
        table.cell(tb, 1, 3, sweep_confirmed ? "✓" : "○", text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 4, "FVG:", text_color=color.white, text_size=size.small)
        table.cell(tb, 1, 4, fvg_confirmed ? "✓" : "○", text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 5, "Entry:", text_color=color.white, text_size=size.small)
        table.cell(tb, 1, 5, entry_fired ? "✓ LIVE" : "○ AWAIT", text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 6, "Stop:", text_color=color.white, text_size=size.small)
        table.cell(tb, 1, 6, na(sweep_extreme) ? "—" : str.tostring(sweep_extreme, "#.00"), text_color=color.white, text_size=size.small)
        table.cell(tb, 0, 7, "Target:", text_color=color.white, text_size=size.small)
        table.cell(tb, 1, 7, na(target) ? "—" : str.tostring(target, "#.00"), text_color=color.white, text_size=size.small)
